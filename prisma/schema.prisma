// THE OTHER SIDE - Prisma Schema (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  username        String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  character       Character?
  missions        Mission[]
  completions     MissionCompletion[]
  worldProgress   WorldProgress?
  worldAreas      WorldAreaProgress[]
  bossProgresses  BossProgress[]
  inventory       InventoryItem[]
  transactions    EconomyTransaction[]

  @@map("users")
}

model Mission {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String
  difficulty  String
  frequency   String
  dueDate     DateTime?
  isActive    Boolean             @default(true)
  status      String              @default("ACTIVE")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completions MissionCompletion[]

  @@index([userId])
  @@map("missions")
}

model MissionCompletion {
  id            String   @id @default(cuid())
  missionId     String
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt   DateTime @default(now())
  xpEarned      Int
  creditsEarned Int

  @@index([missionId])
  @@index([userId])
  @@index([userId, completedAt])
  @@map("mission_completions")
}

model Character {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  archetype  String
  level      Int      @default(1)
  xp         Int      @default(0)
  credits    Int      @default(0)
  mind       Int
  body       Int
  focus      Int
  spirit     Int
  connection Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("characters")
}

model WorldProgress {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  corruption Int      @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("world_progress")
}

model WorldAreaProgress {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaKey            String
  isUnlocked         Boolean  @default(false)
  restorationPercent Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, areaKey])
  @@index([userId])
  @@map("world_area_progress")
}

model BossProgress {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bossKey    String
  currentHp  Int
  maxHp      Int
  isDefeated Boolean   @default(false)
  defeatedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, bossKey])
  @@index([userId])
  @@map("boss_progress")
}

model Item {
  id                 String          @id @default(cuid())
  key                String          @unique
  name               String
  description        String
  category           String // CONSUMABLE, EQUIPMENT, RELIC, COSMETIC
  rarity             String // COMMON, RARE, EPIC, LEGENDARY
  price              Int
  icon               String
  effectType         String // NONE, FOCUS_BOOST, MIND_BOOST, BODY_BOOST, SPIRIT_BOOST, STABILITY_BOOST, COSMETIC_AURA
  effectValue        Int             @default(0)
  slot               String? // MIND, BODY, FOCUS, SPIRIT, CONNECTION, RELIC
  requiredCorruption Int             @default(100) // Unlock threshold
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inventoryItems     InventoryItem[]

  @@map("items")
}

model InventoryItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
  @@map("inventory_items")
}

model EconomyTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // MISSION_REWARD, PURCHASE, REFUND
  amount      Int // e.g. -75, +35
  itemId      String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("economy_transactions")
}
