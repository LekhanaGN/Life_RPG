// THE OTHER SIDE - Prisma Schema (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  username     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  character    Character?
  missions     Mission[]

  @@map("users")
}

model Mission {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String
  difficulty  String
  frequency   String
  dueDate     DateTime?
  isActive    Boolean   @default(true)
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("missions")
}


model Character {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  archetype  String
  level      Int      @default(1)
  xp         Int      @default(0)
  credits    Int      @default(0)
  mind       Int
  body       Int
  focus      Int
  spirit     Int
  connection Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("characters")
}
