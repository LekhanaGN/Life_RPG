// THE OTHER SIDE - Prisma Schema (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  username        String
  timezone        String               @default("UTC")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  character       Character?
  missions        Mission[]
  completions     MissionCompletion[]
  worldProgress   WorldProgress?
  worldAreas      WorldAreaProgress[]
  bossProgresses  BossProgress[]
  inventory       InventoryItem[]
  transactions    EconomyTransaction[]
  streak          UserStreak?
  dailyActivities DailyActivity[]
  milestones      UserMilestone[]
  comebackChallenges ComebackChallenge[]
  worldEvents        UserWorldEvent[]
  unlockedLore       UserLoreUnlock[]
  evidence           MissionEvidence[]
  focusSessions      FocusSession[]

  @@map("users")
}

model Mission {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String
  difficulty  String
  frequency   String
  dueDate              DateTime?
  isActive             Boolean             @default(true)
  status               String              @default("ACTIVE")
  verificationType     String              @default("SELF_REPORT") // SELF_REPORT, EVIDENCE, FOCUS_SESSION
  focusDurationMinutes Int?                @default(25)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  completions          MissionCompletion[]
  evidence             MissionEvidence[]
  focusSessions        FocusSession[]

  @@index([userId])
  @@map("missions")
}

model MissionCompletion {
  id            String   @id @default(cuid())
  missionId     String
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt   DateTime @default(now())
  xpEarned      Int
  creditsEarned Int

  @@index([missionId])
  @@index([userId])
  @@index([userId, completedAt])
  @@map("mission_completions")
}

model Character {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  archetype  String
  level      Int      @default(1)
  xp         Int      @default(0)
  credits    Int      @default(0)
  mind       Int
  body       Int
  focus      Int
  spirit     Int
  connection Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("characters")
}

model WorldProgress {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  corruption Int      @default(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("world_progress")
}

model WorldAreaProgress {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaKey            String
  isUnlocked         Boolean  @default(false)
  restorationPercent Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, areaKey])
  @@index([userId])
  @@map("world_area_progress")
}

model BossProgress {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bossKey    String
  currentHp  Int
  maxHp      Int
  isDefeated Boolean   @default(false)
  defeatedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, bossKey])
  @@index([userId])
  @@map("boss_progress")
}

model Item {
  id                 String          @id @default(cuid())
  key                String          @unique
  name               String
  description        String
  category           String // CONSUMABLE, EQUIPMENT, RELIC, COSMETIC
  rarity             String // COMMON, RARE, EPIC, LEGENDARY
  price              Int
  icon               String
  effectType         String // NONE, FOCUS_BOOST, MIND_BOOST, BODY_BOOST, SPIRIT_BOOST, STABILITY_BOOST, COSMETIC_AURA
  effectValue        Int             @default(0)
  slot               String? // MIND, BODY, FOCUS, SPIRIT, CONNECTION, RELIC
  requiredCorruption Int             @default(100) // Unlock threshold
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inventoryItems     InventoryItem[]

  @@map("items")
}

model InventoryItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
  @@map("inventory_items")
}

model EconomyTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // MISSION_REWARD, PURCHASE, REFUND
  amount      Int // e.g. -75, +35
  itemId      String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("economy_transactions")
}

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActiveDate  DateTime?
  totalActiveDays Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("user_streaks")
}

model DailyActivity {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String   // Logical calendar day YYYY-MM-DD
  missionsCompleted Int      @default(1)
  xpEarned          Int      @default(0)
  creditsEarned     Int      @default(0)
  createdAt         DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_activities")
}

model Milestone {
  id               String          @id @default(cuid())
  key              String          @unique
  name             String
  description      String
  loreQuote        String?
  requirementType  String          // STREAK, ACTIVE_DAYS
  requirementValue Int
  rewardCredits    Int             @default(0)
  rewardXP         Int             @default(0)
  icon             String          @default("Flame")
  createdAt        DateTime        @default(now())
  userMilestones   UserMilestone[]

  @@map("milestones")
}

model UserMilestone {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  unlockedAt  DateTime  @default(now())

  @@unique([userId, milestoneId])
  @@index([userId])
  @@map("user_milestones")
}

model ComebackChallenge {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt         DateTime  @default(now())
  expiresAt         DateTime
  missionsRequired  Int       @default(3)
  missionsCompleted Int       @default(0)
  completed         Boolean   @default(false)
  rewardClaimed     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@map("comeback_challenges")
}

model WorldEvent {
  id                  String           @id @default(cuid())
  key                 String           @unique // SIGNAL_SURGE, STATIC_STORM, etc.
  title               String
  description         String
  loreSnippet         String?
  targetAttribute     String           // FOCUS, MIND, BODY, SPIRIT, CONNECTION, ANY
  targetArea          String?          // e.g. THE_GATE
  requiredCompletions Int              @default(3)
  rewardCredits       Int              @default(60)
  rewardXp            Int              @default(40)
  corruptionChange    Int              @default(0) // Extra corruption reduction upon completion
  bossDamageBonus     Int              @default(0) // Extra damage to active boss
  rarity              String           @default("COMMON") // COMMON, RARE, SPECIAL
  loreId              String?          // Lore log key unlocked on first containment
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  userEvents          UserWorldEvent[]

  @@map("world_events")
}

model UserWorldEvent {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldEventId        String
  worldEvent          WorldEvent  @relation(fields: [worldEventId], references: [id], onDelete: Cascade)
  status              String      @default("ACTIVE") // ACTIVE, COMPLETED, EXPIRED
  progress            Int         @default(0)
  requiredProgress    Int         @default(3)
  completed           Boolean     @default(false)
  rewardClaimed       Boolean     @default(false)
  startsAt            DateTime    @default(now())
  expiresAt           DateTime
  completedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([userId, status, expiresAt])
  @@map("user_world_events")
}

model UserLoreUnlock {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loreKey    String   // LOG_07, LOG_12, etc.
  title      String
  content    String
  source     String   // Event key or origin
  unlockedAt DateTime @default(now())

  @@unique([userId, loreKey])
  @@index([userId])
  @@map("user_lore_unlocks")
}

model MissionEvidence {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  type        String   @default("IMAGE") // IMAGE, TEXT
  fileUrl     String?
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([missionId])
  @@map("mission_evidence")
}

model FocusSession {
  id                       String    @id @default(cuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId                String
  mission                  Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  startedAt                DateTime  @default(now())
  lastHeartbeatAt          DateTime  @default(now())
  requiredDurationSeconds  Int
  accumulatedActiveSeconds Int       @default(0)
  idleSeconds              Int       @default(0)
  status                   String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, EXPIRED, CANCELLED
  completedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([userId, status])
  @@index([missionId])
  @@map("focus_sessions")
}

